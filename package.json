{
  "name": "gurps-action-chases",
  "version": "0.2.6",
  "private": true,
  "type": "module",
  "scripts": {
    "test:setup": "node tools/test-sources.mjs",
    "test": "node tools/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:syntax": "node tools/check-syntax.mjs",
    "build": "node tools/build-release.mjs",
    "test:browser": "node tests/browser-tests.cjs",
    "check": "npm run format:check && npm run check:syntax && npm test && npm run test:browser && npm run build"
  },
  "devDependencies": {
    "linkedom": "0.18.12",
    "prettier": "3.9.6",
    "fflate": "0.8.2",
    "playwright": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Farmeroz/gurps-action-chases.git"
  }
}
